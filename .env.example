OPENAI_API_KEY=
# One-time bake only. Never in the IPA. Never in git.
# Better meditation voice (coral): put credit on this OpenAI key, then:
#   npm run bake-voice:med
# If the key has no credit, Edge neural still works:
#   npm run bake-voice:med-edge
# Listening never calls OpenAI. SOS + meditation MP3s cache on first open (PWA)
# and ship inside the Capacitor app (offline).

# Optional CDN / own hosting. Empty = same-origin /voice/ (PWA + Capacitor bundle).
# Example: https://files.your-domain.com/voice
VITE_VOICE_URL=

# Voice langs: tr az en ru es
