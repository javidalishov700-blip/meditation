{
  "name": "steady",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "bake-voice": "npx --yes tsx scripts/bake-voice.ts",
    "bake-voice:med": "npx --yes tsx scripts/bake-voice.ts --only=med",
    "bake-voice:med-edge": "npx --yes tsx scripts/dump-med-clips.ts /tmp/steady-med-clips.json && python3 scripts/bake-med-edge.py /tmp/steady-med-clips.json",
    "cap:sync": "npm run build && npx cap sync && node scripts/patch-native-locales.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/local-notifications": "^7.0.7",
    "@revenuecat/purchases-capacitor": "^11.3.2",
    "capacitor-native-settings": "^7.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "@tailwindcss/vite": "^4.1.12",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3"
  }
}
